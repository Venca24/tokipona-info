root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 80

[*.{html,htm}]
indent_size = 4
max_line_length = false

[**/{conjunction,context_phrase,interjection,modifier,noun,preposition,separation,special_usage,used_with_kama,verb_intransitive,verb_transitive}.html]
insert_final_newline = false

[*.md]
trim_trailing_whitespace = false
max_line_length = false
